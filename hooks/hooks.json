{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/account-policy-task.js\"",
            "statusMessage": "PIROPLUGIN: Loading account policy",
            "additionalContextLimit": 16000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/account-policy-task.js\"",
            "statusMessage": "PIROPLUGIN: Loading account policy",
            "additionalContextLimit": 16000
          }
        ]
      }
    ]
  }
}
