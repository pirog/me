Host *
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_pirog
    IdentityFile ~/.ssh/id_rsa

Host *.drush.in
    HostkeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa

# AGENTBOX1 hosts
# and also backwards compat for legacy BOTBOX1
Host agentbox1 agentbox1.* agentbox1.tanaab.* 192.168.68.69
    User pirog
    IdentityFile ~/.ssh/id_agentbox1
    IdentityFile ~/.ssh/id_botbox1
    IdentitiesOnly yes
Host botbox1 botbox1.* botbox1.tanaab.* 192.168.68.69
    User pirog
    IdentityFile ~/.ssh/id_agentbox1
    IdentityFile ~/.ssh/id_botbox1
    IdentitiesOnly yes

# EMORI hosts (same machine, same key)
Host emori emori.* emori.tanaab.*
    User pirog
    IdentityFile ~/.ssh/id_agentbox1
    IdentityFile ~/.ssh/id_botbox1
    IdentitiesOnly yes

# LOCAL
Host TANAABAGENTBOX1 TANAABAGENTBOX1.*
    User pirog
    IdentityFile ~/.ssh/id_agentbox1
    IdentityFile ~/.ssh/id_botbox1
    IdentitiesOnly yes
Host TANAABBOTBOX1 TANAABBOTBOX1.*
    User pirog
    IdentityFile ~/.ssh/id_agentbox1
    IdentityFile ~/.ssh/id_botbox1
    IdentitiesOnly yes
