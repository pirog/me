[user]
	name = Mike Pirog
	email = mike@tanaab.dev
	signingkey = ~/.ssh/id_pirog.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-lando
[includeIf "gitdir:~/lando/"]
	path = ~/.gitconfig-lando

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
