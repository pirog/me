<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
    Syntax colors preserve Codex's bundled ANSI theme encoding:
    - AA = 00 uses RR as an ANSI palette index from 00 to 07.
    - AA = 01 uses the terminal's default foreground or background.

    The opaque inserted and deleted backgrounds match the restrained fills
    rendered by Warp's diff panel under Tanaab Solarized Dark.
    -->
    <key>author</key>
    <string>@pirog</string>
    <key>name</key>
    <string>Tanaab Solarized Dark</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
