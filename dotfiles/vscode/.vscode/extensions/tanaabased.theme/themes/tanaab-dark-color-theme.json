  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#748a81", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#adc1b8" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#e25292" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.other.unit"],
      "settings": { "foreground": "#adc1b8" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#e6f0eb" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#38d7d0" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#38d7d0" }
    },
    {
      "name": "Constants and numbers",
      "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant"],
      "settings": { "foreground": "#ffc333" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#33d3a1" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character.format.placeholder"],
      "settings": { "foreground": "#ffc333" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#c7a0ff" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": { "foreground": "#00c88a" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#5ab0ff" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#e25292" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#ffb000" }
    },
    {
      "name": "Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#00c88a", "fontStyle": "bold" }
    },
    {
      "name": "Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#5ab0ff", "fontStyle": "underline" }
    },
    {
      "name": "Bold markup",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffc333", "fontStyle": "bold" }
    },
    {
      "name": "Italic markup",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#e25292", "fontStyle": "italic" }
    },
    {
      "name": "Inserted markup",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#33d3a1" }
    },
    {
      "name": "Deleted markup",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#ff667d" }
    },
    {
      "name": "Changed markup",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffc333" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff667d", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5ab0ff",
    "type": "#5ab0ff",
    "class": "#5ab0ff",
    "enum": "#5ab0ff",
    "interface": "#5ab0ff",
    "struct": "#5ab0ff",
    "typeParameter": "#c7a0ff",
    "parameter": "#38d7d0",
    "variable": "#e6f0eb",
    "variable.readonly": "#ffc333",
    "property": "#38d7d0",
    "property.readonly": "#ffc333",
    "enumMember": "#ffc333",
    "decorator": "#e25292",
    "event": "#e25292",
    "function": "#00c88a",
    "method": "#00c88a",
    "macro": "#e03a83",
    "label": "#5ab0ff",
    "comment": { "foreground": "#748a81", "italic": true },
    "string": "#33d3a1",
    "number": "#ffc333",
    "regexp": "#c7a0ff",
    "operator": "#adc1b8",
    "keyword": "#e25292",
    "*.defaultLibrary": "#5ab0ff",
    "*.deprecated": { "foreground": "#748a81", "strikethrough": true }
  }
}
