  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5f746a", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#52675e" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#9c1c55" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.other.unit"],
      "settings": { "foreground": "#52675e" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#102018" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#087a82" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#087a82" }
    },
    {
      "name": "Constants and numbers",
      "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant"],
      "settings": { "foreground": "#8a5f00" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#007a56" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.character.format.placeholder"],
      "settings": { "foreground": "#9a4d00" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#6f42c1" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": { "foreground": "#007a56" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#0069b8" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#9c1c55" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#8a5f00" }
    },
    {
      "name": "Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#9c1c55", "fontStyle": "bold" }
    },
    {
      "name": "Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#0069b8", "fontStyle": "underline" }
    },
    {
      "name": "Bold markup",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#8a5f00", "fontStyle": "bold" }
    },
    {
      "name": "Italic markup",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#9c1c55", "fontStyle": "italic" }
    },
    {
      "name": "Inserted markup",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#007a56" }
    },
    {
      "name": "Deleted markup",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#b4233c" }
    },
    {
      "name": "Changed markup",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#8a5f00" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b4233c", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#0069b8",
    "type": "#0069b8",
    "class": "#0069b8",
    "enum": "#0069b8",
    "interface": "#0069b8",
    "struct": "#0069b8",
    "typeParameter": "#6f42c1",
    "parameter": "#087a82",
    "variable": "#102018",
    "variable.readonly": "#8a5f00",
    "property": "#087a82",
    "property.readonly": "#8a5f00",
    "enumMember": "#8a5f00",
    "decorator": "#9c1c55",
    "event": "#9c1c55",
    "function": "#007a56",
    "method": "#007a56",
    "macro": "#9c1c55",
    "label": "#0069b8",
    "comment": { "foreground": "#5f746a", "italic": true },
    "string": "#007a56",
    "number": "#8a5f00",
    "regexp": "#6f42c1",
    "operator": "#52675e",
    "keyword": "#9c1c55",
    "*.defaultLibrary": "#0069b8",
    "*.deprecated": { "foreground": "#5f746a", "strikethrough": true }
  }
}
