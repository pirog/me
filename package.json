{
  "name": "@pirog/me",
  "description": "pirog, codified: dotfiles, skills, Codex plugins, workflows, and automations.",
  "version": "1.0.0-beta.14",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirog/me.git"
  },
  "bugs": "https://github.com/pirog/me/issues",
  "homepage": "https://github.com/pirog/me",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2 <1.5.0"
  },
  "type": "module",
  "scripts": {
    "build": "bun ./scripts/build-dist.js",
    "codex:check": "bun ./node_modules/.bin/codex-tools cache check",
    "codex:sync": "bun ./node_modules/.bin/codex-tools cache sync",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "leia": "bun ./node_modules/.bin/leia",
    "lint": "bun run lint:eslint && bun run format:check && bun run lint:shellcheck",
    "lint:eslint": "eslint .",
    "lint:shellcheck": "shellcheck boot.sh",
    "test": "bun run test:unit",
    "test:unit": "bunx --bun mocha \"test/**/*.spec.js\" \"skills/*/test/**/*.spec.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "2.0.0",
    "@tanaab/codex-tools": "^1.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "openclaw": "2026.9.8",
    "prettier": "^3.9.8",
    "shellcheck": "^4.1.0"
  },
  "codexTools": {
    "marketplace": "pirostore",
    "managedPaths": [
      ".agent-system",
      ".codex-plugin",
      ".mcp.json",
      "ACTORS.md",
      "AGENTS.md",
      "AUTOMATIONS.yaml",
      "GOALS.md",
      "MODEL_ROUTING.yaml",
      "WORK_REPOS.md",
      "agent.yaml",
      "setup-host.yaml",
      "setup-agent.yaml",
      "assets",
      "automations",
      "bin",
      "lib",
      "package.json",
      "references",
      "skills",
      "utils"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".agent-system/",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".bun-version",
    ".tool-versions",
    "AGENTS.md",
    "CHANGELOG.md",
    "GOALS.md",
    "INVENTORY.md",
    "PIROBOOT.md",
    "assets/",
    "lib/",
    "references/",
    "skills/",
    "utils/"
  ]
}
