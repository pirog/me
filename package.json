{
  "name": "@pirog/me",
  "description": "Bootstrap script and release tooling for pirog.me.",
  "version": "0.3.0",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": "https://github.com/pirog/me",
  "bugs": "https://github.com/pirog/me/issues",
  "homepage": "https://github.com/pirog/me",
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "^1.0.0-beta.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.4.0",
    "prettier": "^3.5.3",
    "shellcheck": "^4.1.0"
  },
  "scripts": {
    "build": "bun ./scripts/build-dist.js",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check && bun run lint:shellcheck",
    "lint:eslint": "eslint .",
    "lint:shellcheck": "shellcheck boot.sh piroboot.sh",
    "sync:ai": "bun scripts/sync-ai-stow.js"
  }
}
